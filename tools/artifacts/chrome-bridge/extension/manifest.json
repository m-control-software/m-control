{
  "manifest_version": 3,
  "name": "m-control bridge",
  "version": "0.1.0",
  "description": "Runs allowlisted m-control actions on the current tab: YouTube / YouTube Music to mp3.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "nativeMessaging", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Save this YouTube track as mp3 (m-control)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "yt-audio": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Save this YouTube / YouTube Music track as mp3"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
