{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "mctl (built)",
      "program": "${workspaceFolder}/apps/mctl/dist/index.js",
      "args": ["${input:mctlArgs}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "yarn: build",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/{apps,packages}/*/dist/**/*.js"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest: current file",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "mctlArgs",
      "type": "promptString",
      "description": "mctl arguments",
      "default": "list"
    }
  ]
}
